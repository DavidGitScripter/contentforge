# --- LLM ---------------------------------------------------------------------
# mock = offline, kostenlos, deterministisch (Demo/Tests) | anthropic = echte Claude-Calls
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_JUDGE_MODEL=claude-opus-5
LLM_EFFORT=medium
MOCK_LATENCY_S=0.7

# --- Quality Gate & Kosten ----------------------------------------------------
MAX_REVISIONS=2
JUDGE_MIN_AVG=4.0
MAX_CONCURRENT_RUNS=3
DAILY_BUDGET_USD=5

# --- Publishing ----------------------------------------------------------------
# local = ./site (unter /site ausgeliefert) | azure_blob = Azure Storage Static Website
PUBLISHER=local
SITE_BASE_URL=http://localhost:8000/site
AZURE_STORAGE_ACCOUNT_URL=

# --- Integration & Sicherheit ------------------------------------------------------
DASHBOARD_BASE_URL=http://localhost:8000
N8N_WEBHOOK_URL=
# Wenn gesetzt, brauchen schreibende Endpunkte den Header X-API-Key (n8n nutzt denselben Key)
API_KEY=
# Microsoft Teams Workflow-Webhook für Freigabe-Benachrichtigungen (nur n8n)
TEAMS_WEBHOOK_URL=
