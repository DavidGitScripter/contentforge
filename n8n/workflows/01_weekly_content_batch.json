      "name": "Batch in ContentForge starten",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Fasst das Ergebnis des Batch-Aufrufs als Teams-Nachricht zusammen.\nconst res = $input.first().json;\nconst created = res.created ?? [];\nconst lines = created.map((c) => `- ${c.keyword}`).join('\\n') || 'Keine neuen Zellen – alles aktuell.';\nreturn [{\n  json: {\n    created: created.length,\n    skipped: (res.skipped ?? []).length,\n    teamsConfigured: Boolean($env.TEAMS_WEBHOOK_URL),\n    teams: {\n      type: 'message',\n      attachments: [{\n        contentType: 'application/vnd.microsoft.card.adaptive',\n        content: {\n          $schema: 'http://adaptivecards.io/schemas/adaptive-card.json',\n          type: 'AdaptiveCard',\n          version: '1.4',\n          body: [\n            { type: 'TextBlock', text: `ContentForge: ${created.length} neue Content-Pakete in Arbeit`, weight: 'Bolder', size: 'Medium', wrap: true },\n            { type: 'TextBlock', text: lines, wrap: true },\n          ],\n          actions: [{ type: 'Action.OpenUrl', title: 'Dashboard öffnen', url: $env.CONTENTFORGE_DASHBOARD_URL || 'http://localhost:8000' }],\n        },\n      }],\n    },\n  },\n}];"
      },
      "id": "e767b46a-4357-562b-9b39-5d7913d6c89a",
      "name": "Zusammenfassung bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
